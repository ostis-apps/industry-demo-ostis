ui_menu_get_definition 
<- ui_user_command_class_atom; 
<- ui_user_command_class_view_kb; 
<- ui_one_argument_command_class;
=> nrel_main_idtf: 
[Что такое указанное понятие?] (* <- lang_ru;; *);
=> ui_nrel_command_template:
[*
    action_get_definition _-> ._action_get_definition_instance
        (* _-> rrel_1:: ui_arg_1;; *);;
    ._action_get_definition_instance <-_ action;;
*];
=> ui_nrel_command_lang_template: [Что это такое: $ui_arg_1] (* <- lang_ru;; *);;

