ui_menu_explain_relation 
<- ui_user_command_class_atom; 
<- ui_user_command_class_view_kb; 
<- ui_two_argument_command_class;
=> nrel_main_idtf: 
	[Как связаны указанные понятия?] (* <- lang_ru;; *);
=> ui_nrel_command_template:
	[*
		action_explain_relation _-> ._action_explain_relation_instance
			(*
				_-> rrel_1:: ui_arg_1;;
				_-> rrel_2:: ui_arg_2;;
			*);;
		._action_explain_relation_instance <-_ action;;
	*];
=> ui_nrel_command_lang_template: [Как связаны $ui_arg_1 и $ui_arg_2] (* <- lang_ru;; *);;

