-> rrel_mon_class: mon_fault_wash;
-> rrel_mon_cause: mon_wash;
-> rrel_mon_severity: mon_warning;
-> rrel_mon_priority: [5];;

mon_profile_tank
-> rrel_mon_rule: mon_rule_low;
-> rrel_mon_rule: mon_rule_high;
-> rrel_mon_rule: mon_rule_sensor;;

mon_profile_heating
-> rrel_mon_rule: mon_rule_sensor;
-> rrel_mon_rule: mon_rule_temperature_low;
-> rrel_mon_rule: mon_rule_temperature_high;;

mon_profile_valve
-> rrel_mon_rule: mon_rule_sensor;
-> rrel_mon_rule: mon_rule_valve;;

