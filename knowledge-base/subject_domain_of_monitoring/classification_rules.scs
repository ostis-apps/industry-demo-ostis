-> rrel_mon_rule: mon_rule_phase;;

mon_profile_wash
-> rrel_mon_rule: mon_rule_sensor;
-> rrel_mon_rule: mon_rule_wash_wash_temp;
-> rrel_mon_rule: mon_rule_wash_concentration;;

mon_term_level_compliance_low_context
-> rrel_mon_kind: mon_level;
-> rrel_mon_attribute: rrel_mon_compliance;
-> rrel_mon_expected: mon_low;;
mon_context_sensitive -> mon_term_level_compliance_low_context;;

mon_term_level_compliance_high
-> rrel_mon_kind: mon_level;
-> rrel_mon_attribute: rrel_mon_compliance;
-> rrel_mon_expected: mon_high;;

