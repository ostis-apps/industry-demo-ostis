-> rrel_mon_class: mon_fault_pump;
-> rrel_mon_cause: mon_bearing;
-> rrel_mon_severity: mon_critical;
-> rrel_mon_priority: [5];;

mon_rule_route
-> rrel_mon_condition: mon_term_flow_compliance_low;
-> rrel_mon_condition: mon_term_pressure_compliance_low;
-> rrel_mon_condition: mon_term_open_compliance_high;
-> rrel_mon_class: mon_fault_restricted;
-> rrel_mon_cause: mon_restriction;
-> rrel_mon_severity: mon_critical;
-> rrel_mon_priority: [5];;

mon_rule_sensor
-> rrel_mon_condition: mon_term_sensor_validation_unreliable;
-> rrel_mon_class: mon_fault_bad_sensor;
-> rrel_mon_cause: mon_instrument;
-> rrel_mon_severity: mon_critical;
-> rrel_mon_priority: [10];;

mon_rule_phase
