mon_fault_low_level
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: низкий уровень в ёмкости] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_overflow
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: переполнение ёмкости] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_thermal
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: температура вне режима] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_valve
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: клапан не достиг положения] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_pump
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: перегрузка или износ насоса] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_restricted
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: падение расхода и давления при открытом маршруте] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_bad_sensor
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: недостоверный датчик] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_timeout
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: таймаут фазы] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_fault_wash
<- sc_node_class;
=> nrel_main_idtf: [нештатная ситуация: неэффективная мойка] (* <- lang_ru;; *);
<= nrel_inclusion: emergency;;

mon_rule_low
-> rrel_mon_condition: mon_term_level_compliance_low_context;
-> rrel_mon_class: mon_fault_low_level;
-> rrel_mon_cause: mon_supply;
-> rrel_mon_severity: mon_critical;
-> rrel_mon_priority: [5];;

mon_rule_high
-> rrel_mon_condition: mon_term_level_compliance_high;
-> rrel_mon_class: mon_fault_overflow;
-> rrel_mon_cause: mon_inlet;
-> rrel_mon_severity: mon_critical;
-> rrel_mon_priority: [6];;

mon_rule_temperature_low
-> rrel_mon_condition: mon_term_temp_compliance_low_5;
-> rrel_mon_class: mon_fault_thermal;
-> rrel_mon_cause: mon_heating;
-> rrel_mon_severity: mon_critical;
-> rrel_mon_priority: [5];;

mon_rule_temperature_high
-> rrel_mon_condition: mon_term_temp_compliance_high_5;
