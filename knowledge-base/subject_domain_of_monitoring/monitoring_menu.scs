ui_menu_mon_analysis
<- ui_user_command_class_noatom;
=> nrel_main_idtf: [Анализ оборудования] (* <- lang_ru;; *);
<= nrel_ui_commands_decomposition: {
    ui_menu_mon_validation;
    ui_menu_mon_threshold;
    ui_menu_mon_prediction;
    ui_menu_mon_wear;
    ui_menu_mon_context;
    ui_menu_mon_classify;
    ui_menu_mon_assess
};;

ui_menu_mon_validation
<- ui_user_command_class_atom;
=> nrel_main_idtf: [Проверить достоверность показаний] (* <- lang_ru;; *);
<- ui_user_command_class_view_kb;
<- ui_one_argument_command_class;
=> ui_nrel_command_template: [*
    action_mon_assess_object _-> ._request (*
            _-> rrel_1:: ui_arg_1;;
            _-> rrel_2:: mon_validation_method;;
        *);;
    ._request _<- action;;
*];
=> ui_nrel_command_lang_template: [Проверить достоверность показаний — $ui_arg_1] (* <- lang_ru;; *);;

