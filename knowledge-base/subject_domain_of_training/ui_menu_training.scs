ui_menu_generate_quiz
<- ui_user_command_class_atom;
<- ui_user_command_class_view_kb;
<- ui_one_argument_command_class;
=> nrel_main_idtf:
    [Составить проверочные вопросы] (* <- lang_ru;; *);
    [Generate quiz questions] (* <- lang_en;; *);
=> ui_nrel_command_template: [*
    action_generate_quiz _-> ._request
        (*
            _-> rrel_1:: ui_arg_1;;
        *);;
    ._request _<- action;;
*];
=> ui_nrel_command_lang_template:
    [Проверочные вопросы для занятия $ui_arg_1] (* <- lang_ru;; *);
    [Quiz questions for $ui_arg_1] (* <- lang_en;; *);;

