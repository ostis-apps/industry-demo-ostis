ui_menu_submit_training_answer
<- ui_user_command_class_atom;
<- ui_user_command_class_view_kb;
=> nrel_main_idtf:
    [Проверить ответ] (* <- lang_ru;; *);
    [Check answer] (* <- lang_en;; *);
=> ui_nrel_command_template: [*
    action_submit_training_answer _-> ._request
        (*
            _-> rrel_1:: ui_arg_1;;
            _-> rrel_2:: ui_arg_2;;
        *);;
    ._request _<- action;;
*];
=> ui_nrel_command_lang_template:
    [Проверка ответа на вопрос «$ui_arg_1»] (* <- lang_ru;; *);
    [Check the submitted answer to $ui_arg_1] (* <- lang_en;; *);;

ui_menu_show_training_review
<- ui_user_command_class_atom;
<- ui_user_command_class_view_kb;
<- ui_one_argument_command_class;
=> nrel_main_idtf:
