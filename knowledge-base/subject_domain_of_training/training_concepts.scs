// === Классы действий ===
action_explain_procedure
<- sc_node_class;
<- concept_class;
=> nrel_main_idtf:
    [действие объяснения выполнения процедуры] (* <- lang_ru;; *);
    [action to explain procedure execution] (* <- lang_en;; *);
<= nrel_inclusion:
    information_action;;

action_generate_quiz
<- sc_node_class;
<- concept_class;
=> nrel_main_idtf:
    [действие составления проверочных вопросов] (* <- lang_ru;; *);
    [action to generate quiz questions] (* <- lang_en;; *);
<= nrel_inclusion:
    information_action;;

action_conduct_scenario_training
<- sc_node_class;
<- concept_class;
=> nrel_main_idtf:
    [действие проведения тренировки по нештатной ситуации] (* <- lang_ru;; *);
    [action to conduct scenario training] (* <- lang_en;; *);
<= nrel_inclusion:
    information_action;;

